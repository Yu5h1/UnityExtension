#pragma kernel ApplyOscillation
#pragma kernel ApplySurfaceImpulse
#pragma kernel ApplyRollDamping
#pragma kernel ApplySleep
#pragma kernel ApplySpeedLimit

#include "../Shaders/SolverBodyFrameTypes.hlsl"

RWStructuredBuffer<Particle> _Particles;
StructuredBuffer<SolverInstance> _Instances;

#include "../Shaders/SolverBodyFrame.hlsl"

uint _InstanceCount;
float _Time;
float _DeltaTime;

float _OscillationAcceleration;
float _OscillationFrequency;
float _OscillationRandomness;
float _OscillationDirectionAngle;
float _OscillationDirectionRandomness;
float _OscillationMuscleTension;
float _OscillationDuration;
float _OscillationDurationRandomness;
float _OscillationTensionRandomness;
// Launch speed a fully driven body may reach off a surface, in metres per
// second, which is roughly a 46 cm hop. Scaled by the drive weight, so this is
// the ceiling rather than the usual value.
static const float SURFACE_PUSH_SPEED = 3.0;
// 70 degrees. Ceiling on the drive's half angle, short of the 90 that folds the
// head onto the tail.
static const float MAXIMUM_HALF_ANGLE = 1.2217;

float _OscillationVitality;
float _OscillationStiffness;
float _SubDeltaTime;

// Shared by every kernel, not owned by the oscillation modifier: the structural
// unfold below needs it whether or not a modifier is attached.
float3 _UpAxis;

float _RollDamping;
// Shortest chord the body's two ends may be held at, as a fraction of body
// length. Below the 34% the drive itself reaches at full tension, so the floor
// never fights a legitimate beat.
static const float MINIMUM_CHORD_FRACTION = 0.25;
// Lateral opening rate, per frame, and the separate ceiling on how far the
// correction may reach downward in one step.
static const float UNFOLD_SPEED = 0.3;
static const float UNFOLD_DROP_SPEED = 0.5;

// Sleep. Per instance: x = state, y = seconds spent as a candidate.
RWStructuredBuffer<float2> _SleepState;
// Per instance: the pose a sleeping body is held at, _SleepPoseStride entries
// each. Held rather than merely damped, because damping cannot reach this.
RWStructuredBuffer<float3> _SleepPose;
uint _SleepPoseStride;
float _SleepSpeed;
float _SleepDelay;
float _WakeDistance;
float _KeepAwake;

float _SpeedLimit;
float _SpeedDecayRate;

static const float SLEEP_AWAKE = 0.0;
static const float SLEEP_CANDIDATE = 1.0;
static const float SLEEP_SLEEPING = 2.0;

float _SurfaceImpulseSpeed;
float _SurfaceSpreadSeconds;
float _SurfaceDebugTint;
float _SurfaceContactSpeed;
float _SurfaceFrequency;
float _SurfaceRandomness;

[numthreads(64, 1, 1)]
void ApplyOscillation(
    uint3 dispatchID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchID.x;
    if (instanceIndex >= _InstanceCount)
        return;

    SolverInstance instance =
        _Instances[instanceIndex];
    if (instance.topology != TOPOLOGY_CHAIN_3 &&
        instance.topology != TOPOLOGY_GUIDE_4 &&
        instance.topology != TOPOLOGY_DUAL_RAIL_6 &&
        instance.topology != TOPOLOGY_ARTICULATED_12)
    {
        return;
    }

    float phaseRandom =
        Hash01(instanceIndex * 3u + 1u);
    float frequencyRandom =
        Hash01(instanceIndex * 3u + 2u);
    float directionRandom =
        Hash01(instanceIndex * 3u + 3u) *
        2.0 - 1.0;
    float bendRandom =
        Hash01(instanceIndex * 5u + 4u);
    float durationRandom =
        Hash01(instanceIndex * 13u + 11u);
    float frequencyScale = lerp(
        1.0 - _OscillationRandomness,
        1.0 + _OscillationRandomness,
        frequencyRandom);

    // Muscle tension chooses the target shape, running from released to drawn
    // tight: 0 lets the body swing to its fullest, 1 pulls the target straight
    // so the animation flattens out into the topology's own resting form.
    float tensionScale = lerp(
        1.0 - _OscillationTensionRandomness,
        1.0 + _OscillationTensionRandomness,
        bendRandom);
    float muscleTension = saturate(
        1.0 -
        (1.0 - _OscillationMuscleTension) *
        tensionScale);
    // Stop short of folding the head onto the tail.
    //
    // The chord between them is 2 * segmentLength * cos(halfAngle), so a half
    // angle of 90 degrees, which is what tension 0 asked for, puts the two ends
    // in the same place. A body in that pose has no axis at all: which end
    // points forward is genuinely undefined, so the frame the drive measures is
    // set by noise, and the drive rebuilds its pose from that frame on the next
    // step. The cap leaves the chord at 34% of the body length at the fullest.
    //
    // Above tension 0.06 this changes nothing, so existing tuning is untouched;
    // it only clips the bottom of the range, which was never a usable amplitude.
    float peakHalfAngle = min(
        asin(saturate(1.0 - muscleTension)),
        MAXIMUM_HALF_ANGLE);

    // Duration is authored directly: a run set to one second takes one second,
    // whatever shape it is playing. Frequency only says how often a run begins.
    //
    // Between runs the drive is released rather than the wave being zeroed.
    // Zeroing the wave leaves the target at the resting shape, so the body gets
    // actively straightened while it is supposed to be doing nothing, and the
    // lower the frequency the more of the time it spends being held straight.
    // Releasing the drive instead leaves it limp, exactly as Vitality 0 does.
    float burstFrequency =
        _OscillationFrequency * frequencyScale;
    float durationScale = lerp(
        1.0 - _OscillationDurationRandomness,
        1.0 + _OscillationDurationRandomness,
        durationRandom);
    float duration = max(
        0.0,
        _OscillationDuration * durationScale);
    float burstFraction = saturate(
        duration * burstFrequency);

    float wave = 0.0;
    float waveRate = 0.0;
    float playing = 0.0;
    if (burstFraction > 1e-5)
    {
        float cyclePhase =
            _Time * burstFrequency + phaseRandom;
        cyclePhase -= floor(cyclePhase);
        if (cyclePhase < burstFraction)
        {
            float burstPhase =
                cyclePhase / burstFraction;
            wave = sin(burstPhase * TWO_PI);
            waveRate =
                cos(burstPhase * TWO_PI) *
                TWO_PI *
                burstFrequency /
                burstFraction;
            playing = 1.0;
        }
    }

    float3 head =
        ControlCenter(instance, 0u);
    float3 middle =
        ControlCenter(instance, 1u);
    float3 tail =
        ControlCenter(instance, 2u);
    float bodyLength =
        length(head - middle) +
        length(middle - tail);
    if (bodyLength <= 1e-5)
        return;

    // Same frame the articulated mesh shader skins with. Physics and visuals
    // must not build the body frame from two separate implementations.
    ControlFrame bodyFrame =
        GetFrame(instance, 1u);
    float3 tangent = bodyFrame.tangent;
    float3 side = bodyFrame.side;
    float3 normal = bodyFrame.normal;
    float angle = radians(
        _OscillationDirectionAngle +
        directionRandom *
        _OscillationDirectionRandomness);
    float3 direction = normalize(
        side * cos(angle) +
        normal * sin(angle));

    // Amplitude is expressed as an angle, not as a chord offset. The previous
    // chord form placed head and tail back onto the current head-tail axis, so
    // that axis could never swing and the body only pulsed its middle sideways.
    // Rotating both segments about the middle sweeps head and tail through a
    // real arc, which is what reads as a beat instead of a twitch.
    float halfAngle =
        peakHalfAngle * wave;
    float halfAngleVelocity =
        peakHalfAngle * waveRate;
    uint headStart;
    uint headCount;
    uint middleStart;
    uint middleCount;
    uint tailStart;
    uint tailCount;
    BodyRanges(
        instance,
        headStart,
        headCount,
        middleStart,
        middleCount,
        tailStart,
        tailCount);
    uint particleBase =
        (uint)instance.particleOffset;
    uint drivenMiddleCount =
        middleCount +
        (instance.topology ==
            TOPOLOGY_GUIDE_4
            ? 1u
            : 0u);
    float totalDrivenCount =
        (float)(
            headCount +
            drivenMiddleCount +
            tailCount);

    float segmentLength =
        bodyLength * 0.5;
    float sinHalf = sin(halfAngle);
    float cosHalf = cos(halfAngle);

    // Segment directions, head and tail rotated by +/- halfAngle about middle.
    // Both ends offset to the same side of the middle, which is the C bend.
    float3 headDirection =
        tangent * cosHalf +
        direction * sinHalf;
    float3 tailDirection =
        tangent * cosHalf -
        direction * sinHalf;
    float3 headOffset =
        segmentLength * headDirection;
    float3 middleOffset =
        float3(0.0, 0.0, 0.0);
    float3 tailOffset =
        -segmentLength * tailDirection;

    // Build the pose around the same weighted centroid the momentum balance
    // uses. Building on an unweighted centroid and balancing on a weighted one
    // leaves a residual that translates the whole body sideways every frame,
    // which GuideChain4 hit because its middle carries the extra guide.
    float headWeight = (float)headCount;
    float middleWeight = (float)drivenMiddleCount;
    float tailWeight = (float)tailCount;
    float3 weightedCenter = (
        head * headWeight +
        middle * middleWeight +
        tail * tailWeight) /
        totalDrivenCount;
    float3 weightedOffsetMean = (
        headOffset * headWeight +
        middleOffset * middleWeight +
        tailOffset * tailWeight) /
        totalDrivenCount;
    // Stiffness is a rate on the drive, nothing more. It holds no target shape
    // of its own: an earlier version had it pull the body toward a straight
    // rest pose, which meant full hardness straightened whatever it froze
    // instead of freezing it. Reaching the straight shape is Muscle Tension's
    // job, and it gets there through this same animation term.
    float drive =
        _OscillationVitality *
        (1.0 - _OscillationStiffness) *
        playing;

    float3 headDeltaPosition = (
        weightedCenter +
        headOffset -
        weightedOffsetMean -
        head) * drive;
    float3 middleDeltaPosition = (
        weightedCenter +
        middleOffset -
        weightedOffsetMean -
        middle) * drive;
    float3 tailDeltaPosition = (
        weightedCenter +
        tailOffset -
        weightedOffsetMean -
        tail) * drive;

    // Hold the body to the speed the animation implies, instead of letting it
    // arrive in one step.
    //
    // The correction is otherwise applied in full every step, so the body
    // teleports onto the target rather than travelling to it. That is why a run
    // read as instant however long its duration was set: duration paced the
    // target, but nothing paced the body. It is also why a run threw the body
    // clear, since the first step of one has to cross the whole gap left by the
    // idle period, and a jump that size buries the body in whatever it is lying
    // on.
    //
    // The ceiling is the peak speed a control point reaches while tracing the
    // shape over its duration, so a longer duration is both slower and gentler,
    // and the launch scales down with it.
    if (duration > 1e-5)
    {
        float maximumStep =
            TWO_PI * segmentLength *
            peakHalfAngle /
            duration *
            _DeltaTime;
        float longestStep = max(
            length(headDeltaPosition),
            max(
                length(middleDeltaPosition),
                length(tailDeltaPosition)));
        if (longestStep > maximumStep &&
            longestStep > 1e-9)
        {
            float paceScale =
                maximumStep / longestStep;
            headDeltaPosition *= paceScale;
            middleDeltaPosition *= paceScale;
            tailDeltaPosition *= paceScale;
        }
    }

    // Budget how far the pose may reach downward in one step, because the
    // solver turns whatever ends up below a surface into velocity by dividing
    // by the substep rather than the frame, so a millimetre becomes metres per
    // second.
    //
    // Trim the downward component itself and leave the rest of the vector
    // alone. Scaling the whole delta by the overspill instead was throttling
    // sideways motion by the same factor, and reaching a target shape is mostly
    // sideways: a correction needing centimetres laterally and slightly more
    // than the budget downward was being cut to a twentieth in every direction,
    // which read as the target simply never being approached.
    //
    // Trimming per control breaks the zero weighted sum the deltas start with,
    // so the mean is taken back out afterwards to stop the body drifting.
    float maximumDrop =
        drive *
        SURFACE_PUSH_SPEED *
        _SubDeltaTime;

    float headRise = dot(
        headDeltaPosition,
        _UpAxis);
    float middleRise = dot(
        middleDeltaPosition,
        _UpAxis);
    float tailRise = dot(
        tailDeltaPosition,
        _UpAxis);

    // Scale the vertical components together rather than trimming each one.
    //
    // The three rises already sum to zero by weight, and a common factor keeps
    // it that way, so nothing has to be rebalanced afterwards. Trimming them
    // individually and then removing the mean does not work: the removal pushes
    // the trimmed control straight back past the limit, by an order of
    // magnitude in the ordinary case, which leaves the budget doing nothing.
    float deepestDrop = -min(
        headRise,
        min(middleRise, tailRise));

    if (deepestDrop > maximumDrop &&
        deepestDrop > 1e-9)
    {
        float verticalScale =
            maximumDrop / deepestDrop;
        headDeltaPosition +=
            _UpAxis *
            (headRise * verticalScale - headRise);
        middleDeltaPosition +=
            _UpAxis *
            (middleRise * verticalScale -
             middleRise);
        tailDeltaPosition +=
            _UpAxis *
            (tailRise * verticalScale - tailRise);
    }

    // Analytic derivative of the pose above.
    float3 headDirectionRate =
        (-tangent * sinHalf +
          direction * cosHalf) *
        halfAngleVelocity;
    float3 tailDirectionRate =
        (-tangent * sinHalf -
          direction * cosHalf) *
        halfAngleVelocity;
    float3 headOffsetVelocity =
        segmentLength * headDirectionRate;
    float3 middleOffsetVelocity =
        float3(0.0, 0.0, 0.0);
    float3 tailOffsetVelocity =
        -segmentLength * tailDirectionRate;
    // Velocity carries only the pose's own rate of change. It must not try to
    // cancel the particle's existing velocity: a body resting on a net or hung
    // under tension has large contact-driven velocity spread, and folding that
    // into the drive let the clamp below collapse and take the position channel
    // with it. Bending has to win over contact response, not be throttled by it.
    float3 weightedOffsetVelocityMean = (
        headOffsetVelocity * headWeight +
        middleOffsetVelocity * middleWeight +
        tailOffsetVelocity * tailWeight) /
        totalDrivenCount;
    // Gated by the drive, exactly as the pose is.
    //
    // Left ungated this kept injecting deformation velocity on every step even
    // with Vitality at 0 or between runs, when nothing is supposed to be
    // driving at all. While a body is moving its own motion hides that; once it
    // settles there is nothing left but the injection, which keeps stirring the
    // body and turning its frame. Stiffness 1 appeared to cure the problem only
    // because converging the velocities wipes the injection back out again.
    float3 headDeltaVelocity = (
        headOffsetVelocity -
        weightedOffsetVelocityMean) * drive;
    float3 middleDeltaVelocity = (
        middleOffsetVelocity -
        weightedOffsetVelocityMean) * drive;
    float3 tailDeltaVelocity = (
        tailOffsetVelocity -
        weightedOffsetVelocityMean) * drive;

    // The pose is always reached in full. Only the momentum injected on top of
    // it is limited, so a low acceleration yields a beat with less follow
    // through rather than a body that cannot bend at all.
    float maximumVelocityCorrection =
        max(0.0, _OscillationAcceleration) *
        _DeltaTime;
    float largestDeltaVelocity = max(
        length(headDeltaVelocity),
        max(
            length(middleDeltaVelocity),
            length(tailDeltaVelocity)));
    float velocityScale =
        (largestDeltaVelocity >
            maximumVelocityCorrection &&
         largestDeltaVelocity > 1e-6)
            ? maximumVelocityCorrection /
              largestDeltaVelocity
            : 1.0;
    headDeltaVelocity *= velocityScale;
    middleDeltaVelocity *= velocityScale;
    tailDeltaVelocity *= velocityScale;

    for (uint headIndex = 0u;
         headIndex < headCount;
         headIndex++)
    {
        uint index =
            particleBase +
            headStart +
            headIndex;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            particle.position +=
                headDeltaPosition;
            particle.prevPosition +=
                headDeltaPosition;
            particle.velocity +=
                headDeltaVelocity;
        }
        _Particles[index] = particle;
    }

    for (uint middleIndex = 0u;
         middleIndex < middleCount;
         middleIndex++)
    {
        uint index =
            particleBase +
            middleStart +
            middleIndex;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            particle.position +=
                middleDeltaPosition;
            particle.prevPosition +=
                middleDeltaPosition;
            particle.velocity +=
                middleDeltaVelocity;
        }
        _Particles[index] = particle;
    }

    if (instance.topology == TOPOLOGY_GUIDE_4)
    {
        uint guideIndex = particleBase + 3u;
        Particle guide = _Particles[guideIndex];
        if (guide.invMass > 0.0)
        {
            guide.position +=
                middleDeltaPosition;
            guide.prevPosition +=
                middleDeltaPosition;
            guide.velocity +=
                middleDeltaVelocity;
        }
        _Particles[guideIndex] = guide;
    }

    for (uint tailIndex = 0u;
         tailIndex < tailCount;
         tailIndex++)
    {
        uint index =
            particleBase +
            tailStart +
            tailIndex;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            particle.position +=
                tailDeltaPosition;
            particle.prevPosition +=
                tailDeltaPosition;
            particle.velocity +=
                tailDeltaVelocity;
        }
        _Particles[index] = particle;
    }

    // Freeze: converge the particles onto the body's own mean velocity.
    //
    // Deformation is what the particles do relative to each other, so removing
    // that relative motion locks the shape the body currently has, whatever
    // shape that happens to be. The mean survives untouched, so the body still
    // travels, falls and collides as a whole; it just stops changing form.
    //
    // Nothing here pulls toward any particular shape. Stiffness only refuses
    // further change, which is why it can freeze a curled body curled.
    if (_OscillationStiffness > 0.0)
    {
        uint frozenIndex;
        uint frozenCount = 0u;
        float3 meanVelocity =
            float3(0.0, 0.0, 0.0);
        for (frozenIndex = 0u;
             frozenIndex < (uint)instance.particleCount;
             frozenIndex++)
        {
            Particle sample =
                _Particles[
                    particleBase + frozenIndex];
            if (sample.invMass <= 0.0)
                continue;
            meanVelocity += sample.velocity;
            frozenCount++;
        }

        if (frozenCount > 0u)
        {
            meanVelocity /= (float)frozenCount;
            for (frozenIndex = 0u;
                 frozenIndex < (uint)instance.particleCount;
                 frozenIndex++)
            {
                uint index =
                    particleBase + frozenIndex;
                Particle particle =
                    _Particles[index];
                if (particle.invMass > 0.0)
                {
                    particle.velocity = lerp(
                        particle.velocity,
                        meanVelocity,
                        _OscillationStiffness);
                }
                _Particles[index] = particle;
            }
        }
    }
}

// Damps the guide particle's orbit around the spine.
//
// GuideChain4 has no resistance to this at all, not merely a weak one. Its
// three constraints on the guide all reach points on the spine, and the spine
// is a straight line, so rotating the guide about that line leaves every one of
// those distances unchanged. The guide is free to drift around the body
// indefinitely, and it is the sole source of the body's cross direction, so the
// frame drifts with it and the mesh wrings along its length.
//
// The counter impulse is spread across the three spine particles so linear
// momentum is unchanged and no single one of them visibly kicks back.
void DampGuideOrbit(
    uint particleBase,
    float3 axis,
    float strength)
{
    Particle guide =
        _Particles[particleBase + 3u];
    if (guide.invMass <= 0.0)
        return;

    Particle middle =
        _Particles[particleBase + 1u];
    float3 radius =
        guide.position - middle.position;
    float3 radial =
        radius - axis * dot(radius, axis);
    float radialLength = length(radial);
    if (radialLength <= 1e-6)
        return;

    float3 orbitDirection =
        cross(axis, radial / radialLength);
    float3 relativeVelocity =
        guide.velocity - middle.velocity;
    float3 correction =
        orbitDirection *
        (-strength *
         dot(relativeVelocity, orbitDirection));

    guide.velocity += correction;
    _Particles[particleBase + 3u] = guide;

    float3 share = correction / 3.0;
    for (uint spineIndex = 0u;
         spineIndex < 3u;
         spineIndex++)
    {
        uint index = particleBase + spineIndex;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
            particle.velocity -= share;
        _Particles[index] = particle;
    }
}

// Removes a fraction of a control group's spin about the body axis.
//
// Nothing in the topology resists rotation about the long axis: the distance
// constraints are indifferent to it, and every driver applies the same delta to
// every particle in a group, so a group is free to keep rolling once it starts.
// The result is a bend plane that precesses around the body and reads as a
// corkscrew. Damping the roll rate leaves genuine tumbling intact while
// stopping the spiral from accumulating.
//
// Equal and opposite impulses about the group centre, so linear momentum is
// untouched. Groups of one particle carry no roll information and are skipped,
// which is why Chain3 and GuideChain4 cannot be stabilised this way.
void DampGroupRoll(
    uint particleBase,
    uint start,
    uint count,
    float3 axis,
    float strength)
{
    if (count < 2u)
        return;

    float3 center = float3(0.0, 0.0, 0.0);
    float3 meanVelocity = float3(0.0, 0.0, 0.0);
    uint i;
    for (i = 0u; i < count; i++)
    {
        Particle particle =
            _Particles[particleBase + start + i];
        center += particle.position;
        meanVelocity += particle.velocity;
    }
    float inverseCount = 1.0 / (float)count;
    center *= inverseCount;
    meanVelocity *= inverseCount;

    float angularNumerator = 0.0;
    float inertia = 0.0;
    for (i = 0u; i < count; i++)
    {
        Particle particle =
            _Particles[particleBase + start + i];
        float3 radius =
            particle.position - center;
        float3 radialPerpendicular =
            radius -
            axis * dot(radius, axis);
        float3 relativeVelocity =
            particle.velocity - meanVelocity;
        angularNumerator += dot(
            cross(
                radialPerpendicular,
                relativeVelocity),
            axis);
        inertia += dot(
            radialPerpendicular,
            radialPerpendicular);
    }

    if (inertia <= 1e-8)
        return;

    float3 deltaAngularVelocity =
        axis *
        (-strength *
         angularNumerator /
         inertia);
    for (i = 0u; i < count; i++)
    {
        uint index =
            particleBase + start + i;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            float3 radius =
                particle.position - center;
            float3 radialPerpendicular =
                radius -
                axis * dot(radius, axis);
            particle.velocity += cross(
                deltaAngularVelocity,
                radialPerpendicular);
        }
        _Particles[index] = particle;
    }
}

// Keeps the body's two ends out of each other's place.
//
// Nothing in a three-control topology limits how far the two halves may fold
// onto each other. The head-tail bend constraint is soft and every other
// constraint is indifferent to the fold, so a body squeezed against its
// neighbours inside a net can be pressed until the head group and the tail group
// sit on the same point. Open ground rarely presses hard enough from both sides
// at once, which is why the fault reads as a net-only one.
//
// Once there it stays there, and that is a trap rather than a stable pose. A
// hairpin has no body axis: which end points forward is genuinely undefined, so
// the axis every driver measures is decided by whatever asymmetry is left over,
// it re-rolls every step, and the drive that ought to be prying the ends apart
// instead throws them around a small neighbourhood in a fresh direction each
// frame. The sticking and the spinning are one fault, not two.
//
// Enforced as a floor on the chord rather than as a force, because the fold is
// held shut by contact and a force would have to out-push whatever is squeezing.
//
// Momentum is untouched. Head and tail groups carry equal particle counts in
// every topology, so equal and opposite deltas cancel exactly.
void UnfoldHairpin(
    SolverInstance instance)
{
    float3 head =
        ControlCenter(instance, 0u);
    float3 middle =
        ControlCenter(instance, 1u);
    float3 tail =
        ControlCenter(instance, 2u);

    float3 headSegment = head - middle;
    float3 tailSegment = middle - tail;
    float headSegmentLength = length(headSegment);
    float tailSegmentLength = length(tailSegment);
    float bodyLength =
        headSegmentLength + tailSegmentLength;
    if (bodyLength <= 1e-5)
        return;

    float3 chord = head - tail;
    float chordLength = length(chord);
    float minimumChord =
        bodyLength * MINIMUM_CHORD_FRACTION;
    if (chordLength >= minimumChord)
        return;

    // Which way to open.
    //
    // Along the chord while the chord still has a length worth trusting.
    // Separating two points is only defined along the line between them, and
    // that line is exactly what vanishes here, so hand over to the body's own
    // cross direction as it goes. That direction is carried by the off-spine
    // particles, so it is real rather than assumed; it is perpendicular to the
    // spine, which is the only way the ends can travel without stretching their
    // own segments; and it does not degenerate at a hairpin, because the guide
    // or the rails are still where they were. Blended rather than switched, so
    // the push cannot change direction between one step and the next.
    float3 headSegmentDirection =
        headSegmentLength > 1e-6
            ? headSegment / headSegmentLength
            : float3(0.0, 0.0, 0.0);
    float3 tailSegmentDirection =
        tailSegmentLength > 1e-6
            ? tailSegment / tailSegmentLength
            : float3(0.0, 0.0, 0.0);
    float3 spine = BisectDirections(
        headSegmentDirection,
        tailSegmentDirection,
        headSegmentDirection);
    float3 baseX =
        RotateByQuaternion(
            float3(1.0, 0.0, 0.0),
            instance.spawnRotation);
    float3 crossDirection = SafePerpendicular(
        SideCandidate(instance, 1u, middle),
        spine,
        baseX);

    float confidence = saturate(
        chordLength /
        (0.25 * minimumChord));
    float3 chordDirection =
        chordLength > 1e-9
            ? chord / chordLength
            : float3(0.0, 0.0, 0.0);
    // Take only the part of the cross direction the chord does not already
    // account for.
    //
    // Blending the two raw directions can cancel them outright. Near a hairpin
    // the chord is itself perpendicular to the spine, so it can sit anti-parallel
    // to the cross direction, and the mix then vanishes around the halfway
    // point: the one pose that most needs a push would be left without one.
    // Made orthogonal, the chord's own share of the result is exactly the blend
    // weight, so the correction always opens the body rather than displacing it.
    float3 crossPerpendicular =
        crossDirection -
        chordDirection *
        dot(crossDirection, chordDirection);
    float3 openCandidate =
        chordDirection * confidence +
        crossPerpendicular * (1.0 - confidence);
    float openLength = length(openCandidate);
    if (openLength <= 1e-6)
        return;
    float3 openDirection =
        openCandidate / openLength;

    // Half the shortfall to each end, paced so the correction crosses the gap
    // over several frames rather than teleporting through whatever is holding
    // the body shut.
    float3 delta =
        openDirection *
        min(
            (minimumChord - chordLength) * 0.5,
            UNFOLD_SPEED * _DeltaTime);

    // Separate, much tighter ceiling on how far the correction may reach along
    // the gravity axis, in substep units.
    //
    // The solver turns positional change into velocity by dividing by the
    // substep rather than the frame, so a step that is harmless sideways
    // launches the body when it points down, and one of the two ends always
    // does. Scaled by a common factor so the pair stays equal and opposite;
    // trimming the downward end alone would leave a net push on the body.
    float drop = abs(dot(delta, _UpAxis));
    float maximumDrop =
        UNFOLD_DROP_SPEED * _SubDeltaTime;
    if (drop > maximumDrop && drop > 1e-9)
    {
        float3 along =
            _UpAxis * dot(delta, _UpAxis);
        delta =
            (delta - along) +
            along * (maximumDrop / drop);
    }

    uint headStart;
    uint headCount;
    uint middleStart;
    uint middleCount;
    uint tailStart;
    uint tailCount;
    BodyRanges(
        instance,
        headStart,
        headCount,
        middleStart,
        middleCount,
        tailStart,
        tailCount);
    uint particleBase =
        (uint)instance.particleOffset;

    // prevPosition follows the correction so the solver does not read it as
    // velocity on the next substep.
    uint i;
    for (i = 0u; i < headCount; i++)
    {
        uint index =
            particleBase + headStart + i;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            particle.position += delta;
            particle.prevPosition += delta;
        }
        _Particles[index] = particle;
    }

    for (i = 0u; i < tailCount; i++)
    {
        uint index =
            particleBase + tailStart + i;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
        {
            particle.position -= delta;
            particle.prevPosition -= delta;
        }
        _Particles[index] = particle;
    }
}

[numthreads(64, 1, 1)]
void ApplyRollDamping(
    uint3 dispatchID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchID.x;
    if (instanceIndex >= _InstanceCount)
        return;

    SolverInstance instance =
        _Instances[instanceIndex];

    // Structural, and ahead of the gates below: a body folded onto itself has
    // no usable axis, and roll damping, settle and the mesh all read that axis.
    // Chain3 is included here even though it has no roll to damp, because the
    // fold is a property of having three controls rather than of having
    // off-spine particles.
    if (instance.topology == TOPOLOGY_CHAIN_3 ||
        instance.topology == TOPOLOGY_GUIDE_4 ||
        instance.topology == TOPOLOGY_DUAL_RAIL_6 ||
        instance.topology == TOPOLOGY_ARTICULATED_12)
    {
        UnfoldHairpin(instance);
    }

    // Roll damping is chain-only. It damps rotation about the body's long axis,
    // and a rigid fragment has no long axis: GetFrame would read particles 0, 1
    // and 2 as if they were head, middle and tail, which for a tetrahedron means
    // three arbitrary corners. Rigid bodies are held still by ApplySleep instead.
    if (instance.topology != TOPOLOGY_GUIDE_4 &&
        instance.topology != TOPOLOGY_DUAL_RAIL_6 &&
        instance.topology != TOPOLOGY_ARTICULATED_12)
    {
        return;
    }

    float strength = saturate(_RollDamping);
    if (strength <= 0.0)
        return;

    float3 axis =
        GetFrame(instance, 1u).tangent;

    // A lone guide has nothing to be aligned against, so only damping applies.
    // Its control groups are single particles, which the group routines below
    // skip anyway.
    if (instance.topology == TOPOLOGY_GUIDE_4)
    {
        if (strength > 0.0)
        {
            DampGuideOrbit(
                (uint)instance.particleOffset,
                axis,
                strength);
        }
        return;
    }

    uint headStart;
    uint headCount;
    uint middleStart;
    uint middleCount;
    uint tailStart;
    uint tailCount;
    BodyRanges(
        instance,
        headStart,
        headCount,
        middleStart,
        middleCount,
        tailStart,
        tailCount);
    uint particleBase =
        (uint)instance.particleOffset;

    if (strength > 0.0)
    {
        DampGroupRoll(
            particleBase,
            headStart,
            headCount,
            axis,
            strength);
        DampGroupRoll(
            particleBase,
            middleStart,
            middleCount,
            axis,
            strength);
        DampGroupRoll(
            particleBase,
            tailStart,
            tailCount,
            axis,
            strength);
    }

}

// Bleeds off travel speed above a threshold, instead of clamping it.
//
// A hard ceiling makes everything that crosses it come out at exactly the same
// speed, so a body flung hard and one nudged past the limit become
// indistinguishable in the same frame. That reads as obviously artificial, and
// the ordering it destroys is real information. Decaying the excess keeps the
// order and only compresses the spread: harder still means faster, and the
// difference closes over a few frames instead of vanishing in one.
//
// Below the threshold this does nothing whatever, which is what separates it
// from global damping. Damping pulls on everything all the time, so raising it
// enough to catch a launch also makes ordinary motion sluggish.
//
// Acts on the instance's mean velocity, never per particle. A fish's tail tip
// legitimately moves faster than its centre, and clamping particles
// individually would flatten the body's own motion into the limit. Adding the
// same correction to every particle scales the mean and leaves every relative
// velocity untouched.
//
// Only reaches bodies that are actually free. Where a contact or shape matching
// writes the position in the same substep, the velocity is rebuilt from that
// position and this is overwritten. That is the correct scope: it exists for
// bodies thrown by a depenetration or a moving collider, not as friction and
// not as a substitute for Sleep.
[numthreads(64, 1, 1)]
void ApplySpeedLimit(
    uint3 dispatchID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchID.x;
    if (instanceIndex >= _InstanceCount)
        return;
    if (_SpeedLimit <= 0.0)
        return;

    SolverInstance instance =
        _Instances[instanceIndex];
    uint particleBase =
        (uint)instance.particleOffset;
    uint count = (uint)max(0, instance.particleCount);
    if (count == 0)
        return;

    uint i;
    float3 meanVelocity = float3(0.0, 0.0, 0.0);
    uint movable = 0u;
    for (i = 0; i < count; i++)
    {
        Particle sample =
            _Particles[particleBase + i];
        if (sample.invMass <= 0.0)
            continue;
        meanVelocity += sample.velocity;
        movable++;
    }
    if (movable == 0u)
        return;

    meanVelocity /= (float)movable;
    float speed = length(meanVelocity);
    if (speed <= _SpeedLimit || speed <= 1e-6)
        return;

    float excess = speed - _SpeedLimit;
    float target =
        _SpeedLimit +
        excess * exp(-_SpeedDecayRate * _DeltaTime);
    float3 correction =
        meanVelocity * (target / speed - 1.0);

    for (i = 0; i < count; i++)
    {
        uint index = particleBase + i;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0)
            particle.velocity += correction;
        _Particles[index] = particle;
    }
}

// Stops a settled instance moving, by writing positions rather than velocities.
//
// This kernel exists because damping cannot do the job, and the reason is
// structural rather than a matter of tuning. UnifiedSolver.compute ends every
// substep with
//
//     p.velocity = (p.position - p.prevPosition) / subDt
//
// which overwrites velocity outright. A modifier runs once per FixedUpdate,
// outside that loop, so a velocity it writes survives exactly one Predict out of
// `substeps` before being recomputed from positions. At 30 substeps that is
// about three percent of the intent, and zero wherever a contact or shape
// matching writes the position anyway, which is every case this is aimed at.
// A `settleSpeed` control was built on the velocity channel for this job and
// removed once it was clear it could not work; do not reintroduce one.
//
// Positions are the channel that holds. Writing `prevPosition` alongside
// `position` is what makes it stick: the difference between them is the only
// thing UpdateVelocity reads, so setting them equal produces a genuine zero
// rather than one that is immediately recomputed away.
//
// Runs after the solver has stepped: SolverManager has no execution order and
// so sits at 0, while the runner is at 50. Each dispatch therefore sees what the
// solver just did and corrects it before the next frame's Predict.
[numthreads(64, 1, 1)]
void ApplySleep(
    uint3 dispatchID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchID.x;
    if (instanceIndex >= _InstanceCount)
        return;
    if (_SleepSpeed <= 0.0)
        return;

    SolverInstance instance =
        _Instances[instanceIndex];
    uint particleBase =
        (uint)instance.particleOffset;
    uint count = (uint)max(0, instance.particleCount);
    if (count == 0)
        return;
    count = min(count, _SleepPoseStride);

    uint poseBase =
        instanceIndex * _SleepPoseStride;
    float2 state = _SleepState[instanceIndex];
    uint i;

    // A body under a continuous modifier must never sleep, and must wake the
    // moment one is enabled. The drive writes a pose every step, so a sleeping
    // instance would fight it and win, holding a body still while it is being
    // told to move.
    if (_KeepAwake > 0.5)
    {
        _SleepState[instanceIndex] =
            float2(SLEEP_AWAKE, 0.0);
        return;
    }

    if (state.x == SLEEP_SLEEPING)
    {
        // Wake on displacement, not on speed.
        //
        // A sleeping body has its velocity held at zero by this kernel, so it
        // can never report motion of its own; asking it how fast it is going
        // would keep it asleep through anything. How far the solver managed to
        // push it since the last frame is the honest signal, and it covers
        // every source at once: another fragment landing on it, a fish, a
        // moving collider, a pile shifting underneath.
        float displaced = 0.0;
        for (i = 0; i < count; i++)
        {
            displaced = max(
                displaced,
                length(
                    _Particles[particleBase + i].position -
                    _SleepPose[poseBase + i]));
        }

        if (displaced > _WakeDistance)
        {
            _SleepState[instanceIndex] =
                float2(SLEEP_AWAKE, 0.0);
            return;
        }

        // Wake on a push that will not stop, as well as on a big one.
        //
        // Holding the pose is itself what stops a wedged body reporting that it
        // is wedged: the restore undoes the depenetration every frame, so the
        // displacement never grows and the test above never fires. A fragment
        // that ended up inside a wall stayed there permanently, and the harder
        // this kernel held it the less able it was to say so.
        //
        // Persistence separates the two cases where magnitude cannot. A body
        // that is genuinely at rest has nothing pushing it, so the correction it
        // comes back with is essentially zero. A wedged one comes back with the
        // same correction every frame for as long as it is stuck. So a small
        // displacement that never goes away is the signal, and it needs no
        // threshold of its own: a tenth of the distance that would wake it
        // outright, sustained for as long as it took to fall asleep.
        //
        // Waking is a retry rather than a fix. The restore stops, the solver
        // gets a clear run at pushing it out, and it falls asleep again wherever
        // it lands. Still stuck, and the cycle simply repeats.
        float pushFloor = _WakeDistance * 0.1;
        state.y = displaced > pushFloor
            ? state.y + _DeltaTime
            : 0.0;
        if (state.y > _SleepDelay)
        {
            _SleepState[instanceIndex] =
                float2(SLEEP_AWAKE, 0.0);
            return;
        }

        for (i = 0; i < count; i++)
        {
            uint index = particleBase + i;
            Particle particle = _Particles[index];
            if (particle.invMass > 0.0)
            {
                particle.position =
                    _SleepPose[poseBase + i];
                particle.prevPosition =
                    particle.position;
                particle.velocity =
                    float3(0.0, 0.0, 0.0);
            }
            _Particles[index] = particle;
        }

        // y carries the candidate countdown while awake and the sustained-push
        // timer while asleep. The two phases never overlap, so one field does
        // for both rather than widening the buffer.
        _SleepState[instanceIndex] =
            float2(SLEEP_SLEEPING, state.y);
        return;
    }

    // Awake or candidate. The fastest particle rather than the mean, so a body
    // that is rotating in place still counts as moving.
    float fastest = 0.0;
    for (i = 0; i < count; i++)
    {
        fastest = max(
            fastest,
            length(
                _Particles[particleBase + i].velocity));
    }

    if (fastest > _SleepSpeed)
    {
        _SleepState[instanceIndex] =
            float2(SLEEP_AWAKE, 0.0);
        return;
    }

    state.y += _DeltaTime;
    if (state.y < _SleepDelay)
    {
        _SleepState[instanceIndex] =
            float2(SLEEP_CANDIDATE, state.y);
        return;
    }

    // Falling asleep. Record the pose it will be held at, and zero it out in
    // the same pass so there is no step where it is asleep but still drifting.
    for (i = 0; i < count; i++)
    {
        uint index = particleBase + i;
        Particle particle = _Particles[index];
        _SleepPose[poseBase + i] = particle.position;
        if (particle.invMass > 0.0)
        {
            particle.prevPosition = particle.position;
            particle.velocity =
                float3(0.0, 0.0, 0.0);
        }
        _Particles[index] = particle;
    }
    _SleepState[instanceIndex] =
        float2(SLEEP_SLEEPING, 0.0);
}

// Seconds elapsed since this instance's most recent hop started.
//
// Solved in closed form from the phase rather than tracked, so spreading a hop
// across many steps needs no per-instance timer buffer.
float SurfaceTimeSinceHop(
    float time,
    float frequencyScale,
    float random)
{
    float angularFrequency =
        _SurfaceFrequency *
        frequencyScale *
        TWO_PI;
    if (angularFrequency <= 1e-6)
        return 3.402823466e+38;

    float phase =
        time * angularFrequency +
        random * TWO_PI;
    // floor rounds toward negative infinity, so this wraps correctly for the
    // negative phases that occur before the first hop of a run.
    float sinceHop =
        phase -
        TWO_PI * floor(phase / TWO_PI);
    return sinceHop / angularFrequency;
}

[numthreads(64, 1, 1)]
void ApplySurfaceImpulse(
    uint3 dispatchID : SV_DispatchThreadID)
{
    uint instanceIndex = dispatchID.x;
    if (instanceIndex >= _InstanceCount)
        return;

    SolverInstance instance =
        _Instances[instanceIndex];
    uint particleBase =
        (uint)instance.particleOffset;
    if (instance.particleCount <= 0)
        return;

    // Momentum gate, in place of a contact flag.
    //
    // The solver stores no collision state: Particle carries only position,
    // velocity, prevPosition, invMass, phase, color and visible, and none of
    // the collision kernels write anything but position. So contact has to be
    // inferred, and the reliable signature is that a supported instance stops
    // while a free one keeps accelerating under gravity.
    //
    // The test must use the mean, not individual particles. ApplyOscillation
    // and ApplyRollDamping both run earlier in the same step and write large
    // per-particle velocities, but both are constructed so their deltas sum to
    // zero across the instance. That leaves the centre of mass velocity clean
    // no matter how hard the body is bending, which no per-particle test would
    // survive.
    //
    // Being agnostic to what is doing the supporting is the point: ground,
    // colliders, a sagging cloth net or a pile of other bodies all read the
    // same, where a world-space height plane could only ever describe the first.
    float3 meanVelocity =
        float3(0.0, 0.0, 0.0);
    uint movableCount = 0u;
    for (int contactIndex = 0;
         contactIndex < instance.particleCount;
         contactIndex++)
    {
        Particle contactParticle =
            _Particles[
                particleBase +
                (uint)contactIndex];
        if (contactParticle.invMass <= 0.0)
            continue;
        meanVelocity +=
            contactParticle.velocity;
        movableCount++;
    }

    if (movableCount == 0u)
        return;

    // Reject only the falling case, not motion in general.
    //
    // Testing total speed instead cuts the spread window short: the launch
    // itself raises the mean speed past any threshold low enough to detect
    // resting, so the gate closes after a step or two and delivers a fraction
    // of the intended impulse. The gentler the spread, the sooner it
    // self-terminates, which defeats the whole point.
    //
    // Downward motion is the honest airborne signal. A supported body has its
    // descent cancelled and sits near zero, a falling one keeps gaining speed
    // from gravity, and a body already rising under its own launch is left
    // alone to finish its window. Total stays bounded because the window, not
    // this test, is what limits it.
    meanVelocity /= (float)movableCount;

    float random =
        Hash01(instanceIndex * 2u + 5u);
    float frequencyScale = lerp(
        1.0 - _SurfaceRandomness,
        1.0 + _SurfaceRandomness,
        random);
    float timeSinceHop = SurfaceTimeSinceHop(
        _Time,
        frequencyScale,
        random);

    // Resolved as a state rather than early returns so the debug tint can name
    // which branch was taken. Tinting only the firing path cannot distinguish a
    // kernel that never ran from one that ran and was gated, which are opposite
    // problems.
    //   0 firing      red
    //   1 falling     yellow
    //   2 between hops grey
    int hopState = 0;
    if (meanVelocity.y < -_SurfaceContactSpeed)
        hopState = 1;
    else if (timeSinceHop >=
             _SurfaceSpreadSeconds)
        hopState = 2;

    float3 debugColor =
        hopState == 0
            ? float3(1.0, 0.2, 0.1)
            : hopState == 1
                ? float3(1.0, 0.9, 0.1)
                : float3(0.25, 0.25, 0.25);


    // Spread the launch over a window instead of delivering it in one step.
    //
    // Force is momentum over time, so handing the same total speed over a
    // window ten times longer presses on whatever the body rests against with
    // a tenth of the force, while the body still ends up at the same speed.
    // Delivered in a single step it reads to the cloth solver as an impact,
    // and since a caught body is tangled in the mesh, that impact is what gets
    // returned: the net gets flung instead of the body.
    //
    // This stands in for muscle rebound, so a weak reaction on the support is
    // the goal, not a compromise. It cannot reach zero. The body is entangled
    // and the solver's contacts still obey Newton's third law, so only routing
    // the launch outside contact entirely would, which this kinematic approach
    // cannot do.
    //
    // Launch through velocity only. Never move position here.
    //
    // Teleporting position skips collision entirely: the solver resolves
    // contacts from positions, so a body displaced centimetres in one step
    // passes straight through a cloth mesh instead of pushing on it, and the
    // support shows no reaction at all. It also makes the height depend on how
    // many steps the gate happened to allow, since every skipped step is lift
    // permanently lost.
    //
    // Raising velocity leaves the solver to move the body, so contacts, the
    // support's reaction and the arc all stay real, and a step lost to the gate
    // only fails to top the speed up rather than subtracting from the hop.
    for (int particleIndex = 0;
         particleIndex < instance.particleCount;
         particleIndex++)
    {
        uint index =
            particleBase +
            (uint)particleIndex;
        Particle particle = _Particles[index];
        if (particle.invMass > 0.0 &&
            hopState == 0)
        {
            // Raised to the launch speed rather than accumulated onto it, so a
            // long window cannot stack into a runaway on a body that never gets
            // to move, and every hop leaves at the same speed wherever it
            // started. Holding the floor across the window keeps gravity from
            // eating the launch before the body is clear.
            particle.velocity.y = max(
                particle.velocity.y,
                _SurfaceImpulseSpeed);
        }
        if (_SurfaceDebugTint > 0.5)
            particle.color = debugColor;
        _Particles[index] = particle;
    }
}
