      "steps": [
        {
          "action": {
            "op": "select",
            "key": "b"
          },
          "expect": {
            "slot": "placeholder"
          }
        },
        {
          "action": {
            "op": "select",
            "key": "c"
          },
          "expect": {
            "slot": "placeholder"
          }
        },
        {
          "action": {
            "op": "ready",
            "key": "b"
