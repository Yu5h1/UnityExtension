    {
      "id": "selected-fail-fallback",
      "covers": [
        "BGL-FALLBACK",
        "BGL-NOBLOCK"
      ],
      "initial": {
        "kind": "backgroundLoad",
        "contents": [
          "a",
          "b",
          "c"
        ],
        "state": {
          "slot": null
        }
      },
      "steps": [
        {
          "action": {
            "op": "select",
            "key": "b"
          },
          "expect": {
            "slot": "placeholder"
          }
        },
        {
          "action": {
            "op": "fail",
            "key": "b"
          },
          "expect": {
            "slot": "fallback",
            "fallbackNotice": true,
            "blockingOverlay": false,
            "hostInputAvailable": true
          }
        },
        {
          "action": {
            "op": "select",
            "key": "b"
          },
          "expect": {
            "slot": "placeholder",
            "loadRestarted": true
          }
        }
      ]
    },
