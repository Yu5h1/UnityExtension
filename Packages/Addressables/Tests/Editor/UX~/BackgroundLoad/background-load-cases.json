{
  "schemaVersion": 1,
  "version": "0.1.1-draft",
  "cases": [
    {
      "id": "nonblocking-during-load",
      "covers": [
        "BGL-NOBLOCK"
      ],
      "initial": {
        "kind": "backgroundLoad",
        "contents": [
          "a",
          "b",
          "c"
        ],
        "state": {
          "slot": null
        },
        "prepare": {
          "first": "b"
        }
      },
      "steps": [
        {
          "action": {
            "op": "appStart"
          },
          "expect": {
            "focusMoved": false,
            "blockingOverlay": false,
            "hostInputAvailable": true
          }
        },
        {
          "action": {
            "op": "progress",
            "key": "a",
            "ratio": 0.5
          },
          "expect": {
            "focusMoved": false,
            "blockingOverlay": false,
            "hostInputAvailable": true
          }
        },
        {
          "action": {
            "op": "ready",
            "key": "a"
          },
          "expect": {
            "focusMoved": false,
            "blockingOverlay": false,
            "hostInputAvailable": true
          }
        }
      ]
    },
    {
      "id": "prepare-first-then-rest",
      "covers": [
        "BGL-PREPARE"
      ],
      "initial": {
        "kind": "backgroundLoad",
        "contents": [
          "a",
          "b",
          "c"
        ],
        "state": {
          "slot": null
        },
        "prepare": {
          "first": "b"
        }
      },
      "steps": [
        {
          "action": {
            "op": "appStart"
          },
          "expect": {
            "loadsStarted": [
              "b"
            ]
          }
        },
        {
          "action": {
            "op": "ready",
            "key": "b"
          },
          "expect": {
            "loadsStarted": [
              "b",
              "a"
            ]
          }
        },
        {
          "action": {
            "op": "ready",
            "key": "a"
          },
          "expect": {
            "loadsStarted": [
              "b",
              "a",
              "c"
            ]
          }
        }
      ]
    },
