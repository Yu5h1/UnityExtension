{
  "schema": "yu5h1.motion.particle-solver-cases",
  "version": "1.0.0",
  "spec": "ParticleSolver 1.0.0",
  "units": {
    "length": "m",
    "time": "s",
    "mass": "kg"
  },
  "comparison": "只比對 expected 列出的欄位，逐分量絕對誤差不得超過該案例的 tolerance。steps 是固定步數，每步 fixedDeltaTime 秒、substeps 個子步驟。未列出的世界設定採 ParticleSolver 預設值。media 在步後階段依列出順序作用。collider 的 linearVelocity 表示每步開始時姿勢依此速度平移、表面速度等於該速度。constraints 的 restLength 為明確指定的靜止長度。",
  "cases": [
    {
      "id": "PSOLVE-CASE-01",
      "name": "自由落體",
      "covers": [
        "SOLVER-01",
        "SOLVER-02",
        "SOLVER-16"
      ],
      "world": {
        "fixedDeltaTime": 0.02,
        "substeps": 30,
        "gravity": [
          0,
          -9.81,
          0
        ],
        "damping": 0.0,
        "sor": 1.0,
        "frictionStatic": 0.4,
        "frictionKinetic": 0.2,
        "maxDepenetrationSpeed": 5.0,
        "groundY": -1000.0
      },
      "particles": [
        {
          "position": [
            0,
            1,
            0
          ],
          "velocity": [
            0,
            0,
            0
          ],
          "invMass": 1.0,
          "radius": 0.1,
          "group": 0,
          "category": 1
        }
      ],
      "steps": 10,
      "derivation": "每子步驟 v_k = k·h·g，x_k = x_0 + h²·g·k(k+1)/2；N = 10 步 × 30 子步驟 = 300，h = 0.02/30。",
      "expected": {
        "particles": [
          {
            "index": 0,
            "position": [
              0.0,
              0.803146,
              0.0
            ],
            "velocity": [
              0.0,
              -1.962,
              0.0
            ]
          }
        ]
      },
      "tolerance": {
        "position": 1e-05,
        "velocity": 0.001
      }
    },
