{
  "schemaVersion": 1,
  "version": "1.1.0",
  "cases": [
    {
      "id": "light-mode-uses-light-palette",
      "initial": {},
      "steps": [
        {
          "action": {
            "op": "resolve",
            "mode": "light",
            "systemScheme": "dark"
          },
          "expect": {
            "scheme": "light",
            "roles": {
              "pageBackground": "#f5f3ec",
              "panelBackground": "#fffdf8",
              "heading": "#17211d",
              "panelHeading": "#17211d",
              "itemText": "#27342e",
              "secondaryText": "#4f5e57",
              "border": "#dcd9cf",
              "accent": "#1f684f",
              "hover": "#efeee8",
              "focus": "#1f684f",
              "onAccent": "#ffffff",
              "disabled": "#4f5e57",
              "overlay": "#17233266",
              "danger": "#a33c38",
              "controlBorder": "#808981"
            },
            "warnings": []
          }
        }
      ]
    },
    {
      "id": "dark-mode-uses-dark-palette",
      "initial": {},
      "steps": [
        {
          "action": {
            "op": "resolve",
            "mode": "dark",
