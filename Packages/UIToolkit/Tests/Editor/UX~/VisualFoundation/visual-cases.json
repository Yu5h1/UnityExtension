              "heading": "#eef2f7",
              "panelHeading": "#dfe6ef",
              "itemText": "#cbd4df",
              "secondaryText": "#9da9b8",
              "border": "#343c49",
              "accent": "#7f9fd1",
              "hover": "#2a313c",
              "focus": "#7f9fd1",
              "onAccent": "#000000",
              "disabled": "#9da9b8",
              "overlay": "#00000099",
              "danger": "#f1aaa6",
              "controlBorder": "#737d8c"
            },
            "warnings": []
          }
        }
      ]
    },
    {
      "id": "system-follows-platform-scheme",
      "initial": {},
      "steps": [
        {
          "action": {
            "op": "resolve",
            "mode": "system",
            "systemScheme": "light"
          },
          "expect": {
            "scheme": "light",
            "roles": {
              "pageBackground": "#f5f3ec",
              "itemText": "#27342e",
              "accent": "#1f684f"
            }
          }
        },
        {
          "action": {
            "op": "resolve",
            "mode": "system",
            "systemScheme": "dark"
          },
          "expect": {
            "scheme": "dark",
            "roles": {
              "pageBackground": "#171a21",
              "itemText": "#cbd4df",
              "accent": "#7f9fd1"
            }
          }
        }
      ]
    },
    {
