{
  "schemaVersion": 1,
  "version": "1.0.0",
  "cases": [
    {
      "id": "choice-tap-opens-on-selected-and-escape-returns-focus",
      "initial": {
        "kind": "choice",
        "orientation": "horizontal",
        "placement": "aligned",
        "interaction": "picker",
        "viewport": {
          "width": 400,
          "height": 300
        },
        "trigger": {
          "x": 100,
          "y": 100,
          "width": 40,
          "height": 40
        },
        "focus": "trigger",
        "options": [
          {
            "id": "one",
            "width": 40,
            "height": 40
          },
          {
            "id": "two",
            "width": 40,
            "height": 40,
            "pressed": true
          },
          {
            "id": "three",
            "width": 40,
            "height": 40
          }
        ]
      },
      "steps": [
        {
          "action": {
            "op": "down",
            "pointer": 1,
            "button": 0,
            "t": 0,
            "x": 120,
            "y": 120
          },
          "expect": {
            "emitted": []
          }
        },
        {
          "action": {
            "op": "up",
            "pointer": 1,
            "t": 100,
            "x": 120,
            "y": 120
          },
          "expect": {
            "emitted": [
              {
                "type": "open"
              }
            ],
            "focus": "two",
            "panel": {
              "x": 60,
              "y": 100
            }
          }
        },
        {
          "action": {
            "op": "key",
            "t": 200,
            "key": "Escape",
            "shift": false,
            "alt": false
          },
          "expect": {
            "emitted": [
              {
                "type": "close"
              }
            ],
            "focus": "trigger"
          }
        }
      ]
    },
