/* Yu5h1Lib.UX OptionPicker for UI Toolkit.
   Adopts Yu5h1Lib.UX OptionPicker 3.1.0 on native VisualElement panel + Button.
   - OPT-DISPLAY: panelPadding (4px), optionGap (4px).
   - OPT-APPEARANCE: solid (panelBackground fill, border outline; USS has no shadow, so the outline alone, which the specification
     allows for a platform without shadow) vs ghost (transparent, no outline).
   - Orientation: horizontal (row) vs vertical (column).
   Colours are the VisualFoundation roles (Yu5h1VisualFoundation.uss); hover, selected, focus and disabled of the buttons
   inside the panel come from Yu5h1Button.uss. */

.yu5h1-optionpicker__panel {
    position: absolute;
    padding: 4px;
    border-radius: 6px;
    margin: 0;
}

.yu5h1-optionpicker__panel--horizontal {
    flex-direction: row;
}

.yu5h1-optionpicker__panel--horizontal > .yu5h1-optionpicker__option {
    margin-right: 4px;
}

.yu5h1-optionpicker__panel--horizontal > .yu5h1-optionpicker__option--last {
    margin-right: 0;
}

.yu5h1-optionpicker__panel--vertical {
    flex-direction: column;
}

.yu5h1-optionpicker__panel--vertical > .yu5h1-optionpicker__option {
    margin-bottom: 4px;
}

.yu5h1-optionpicker__panel--vertical > .yu5h1-optionpicker__option--last {
    margin-bottom: 0;
}

.yu5h1-optionpicker__panel--solid {
    background-color: var(--yu5h1-color-panel-background);
    border-width: 1px;
    border-color: var(--yu5h1-color-border);
}

.yu5h1-optionpicker__panel--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
