/* Yu5h1Lib.UX OptionPicker for UI Toolkit.
   Adopts Yu5h1Lib.UX OptionPicker 3.0.2 on native VisualElement panel + Button.
   - OPT-DISPLAY: panelPadding (4px), optionGap (4px).
   - OPT-APPEARANCE: solid (elevated background, border) vs ghost (transparent, no border).
   - Orientation: horizontal (row) vs vertical (column).
   Colours use Unity default theme variables with fallbacks until VisualFoundation is adopted. */

.yu5h1-optionpicker__panel {
    position: absolute;
    padding: 4px;
    border-radius: 6px;
    margin: 0;
}

.yu5h1-optionpicker__panel--horizontal {
    flex-direction: row;
}

.yu5h1-optionpicker__panel--horizontal > .yu5h1-optionpicker__option {
    margin-right: 4px;
}

.yu5h1-optionpicker__panel--horizontal > .yu5h1-optionpicker__option--last {
    margin-right: 0;
}

.yu5h1-optionpicker__panel--vertical {
    flex-direction: column;
}

.yu5h1-optionpicker__panel--vertical > .yu5h1-optionpicker__option {
    margin-bottom: 4px;
}

.yu5h1-optionpicker__panel--vertical > .yu5h1-optionpicker__option--last {
    margin-bottom: 0;
}

.yu5h1-optionpicker__panel--solid {
    background-color: var(--unity-colors-window-background, rgb(245, 245, 247));
    border-width: 1px;
    border-color: var(--unity-colors-default-border, rgba(0, 0, 0, 0.2));
}

.yu5h1-optionpicker__panel--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
