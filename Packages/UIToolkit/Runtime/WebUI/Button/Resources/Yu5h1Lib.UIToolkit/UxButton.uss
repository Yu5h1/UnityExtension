/* Yu5h1Lib.UX Button for UI Toolkit (UxButton). Layout follows BTN-LAYOUT; the colours are the Unity
   default theme's button variables with fallbacks until VisualFoundation is adopted in this package. */

.yu5h1-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 0;
    background-color: var(--unity-colors-button-background, rgb(228, 228, 228));
}

.yu5h1-button:hover {
    background-color: var(--unity-colors-button-background-hover, rgb(236, 236, 236));
}

.yu5h1-button:active,
.yu5h1-button--selected {
    background-color: var(--unity-colors-button-background-pressed, rgb(150, 150, 150));
}

.yu5h1-button--icon-only {
    padding-left: 0;
    padding-right: 0;
}

.yu5h1-button--ghost {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.yu5h1-button--ghost:hover,
.yu5h1-button--ghost:focus {
    background-color: var(--unity-colors-button-background-hover, rgba(0, 0, 0, 0.12));
}

.yu5h1-button--ghost.yu5h1-button--selected,
.yu5h1-button--ghost:active {
    background-color: var(--unity-colors-button-background-pressed, rgba(0, 0, 0, 0.24));
}

.yu5h1-button__icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.yu5h1-button__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}
