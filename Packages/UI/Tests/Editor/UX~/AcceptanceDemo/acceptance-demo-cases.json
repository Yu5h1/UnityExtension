{
  "schemaVersion": 1,
  "version": "0.1.0-draft",
  "cases": [
    {
      "id": "catalog-open",
      "covers": [
        "ACC-CATALOG",
        "ACC-OPEN"
      ],
      "initial": {
        "entries": [
          {
            "id": "button",
            "title": "Button 按鈕",
            "description": "外觀與鍵盤操作"
          },
          {
            "id": "chat-panel",
            "title": "ChatPanel 聊天面板",
            "description": "逐字回覆與圖片"
          },
          {
            "id": "backgroundload",
            "title": "BackgroundLoad 背景載入",
            "description": "圖片與載入進度"
          },
          {
            "id": "grid",
            "title": "Grid 格線",
            "description": "依可用寬度重排"
          }
        ],
        "currentEntryId": "chat-panel"
      },
      "steps": [
        {
          "action": {
            "op": "start"
          },
          "expect": {
            "view": "catalog",
            "visibleIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "focusOrderIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "activeId": null,
            "events": []
          }
        },
        {
          "action": {
            "op": "activateEntry",
            "id": "button"
          },
          "expect": {
            "view": "case",
            "activeId": "button",
            "caseTitle": "Button 按鈕",
            "events": [
              "mount:button"
            ],
            "configuredCurrentId": "chat-panel"
          }
        }
      ]
    },
    {
