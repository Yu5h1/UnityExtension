      "steps": [
        {
          "action": {
            "op": "start"
          },
          "expect": {
            "columns": 1,
            "cardWidth": 220,
            "visibleIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "horizontalOverflow": false
          }
        },
        {
          "action": {
            "op": "resize",
            "availableWidth": 489
          },
          "expect": {
            "columns": 1,
            "cardWidth": 489,
            "visibleIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "horizontalOverflow": false
          }
        },
        {
          "action": {
            "op": "resize",
            "availableWidth": 490
          },
          "expect": {
            "columns": 2,
            "cardWidth": 240,
            "visibleIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "horizontalOverflow": false
          }
        },
        {
          "action": {
            "op": "resize",
            "availableWidth": 740
          },
          "expect": {
            "columns": 3,
            "cardWidth": 240,
            "visibleIds": [
              "button",
              "chat-panel",
              "backgroundload",
              "grid"
            ],
            "horizontalOverflow": false
          }
        },
        {
          "action": {
            "op": "setQuery",
            "query": "圖片"
          },
          "expect": {
            "columns": 2,
            "cardWidth": 365,
            "visibleIds": [
              "chat-panel",
              "backgroundload"
            ],
            "horizontalOverflow": false
          }
        },
        {
          "action": {
            "op": "setQuery",
            "query": "不存在"
          },
          "expect": {
            "columns": 0,
            "visibleIds": [],
            "horizontalOverflow": false
          }
        }
      ]
