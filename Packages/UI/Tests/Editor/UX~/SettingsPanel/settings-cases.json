      ]
    },
    {
      "id": "panel-categories-validated",
      "initial": {
        "kind": "panel",
        "categories": [
          {
            "id": "appearance",
            "label": "外觀"
          },
          {
            "id": "animation",
            "label": "動畫"
          },
          {
            "id": "display",
            "label": "顯示"
          }
        ]
      },
      "steps": [
        {
          "action": {
            "op": "selectTab",
            "id": "display"
          },
          "expect": {
            "emitted": [],
            "view": {
              "active": "display"
            }
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": [
              {
                "id": "Display",
                "label": "顯示"
              }
            ]
          },
          "expect": {
            "emitted": [
              {
                "type": "rejected"
              }
            ],
            "view": {
              "active": "display"
            }
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": [
              {
                "id": "a",
                "label": "A"
              },
              {
                "id": "a",
                "label": "B"
              }
            ]
          },
          "expect": {
            "emitted": [
              {
                "type": "rejected"
              }
            ]
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": [
              {
                "id": "motion-2",
                "label": " "
              }
            ]
          },
          "expect": {
            "emitted": [
              {
                "type": "rejected"
              }
            ]
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": [
              {
                "id": "motion-2",
                "label": "動態"
              },
              {
                "id": "display",
                "label": "顯示"
              }
            ]
          },
          "expect": {
            "emitted": [],
            "view": {
              "active": "display"
            }
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": [
              {
                "id": "motion-2",
                "label": "動態"
              }
            ]
          },
          "expect": {
            "emitted": [],
            "view": {
              "active": "motion-2"
            }
          }
        },
        {
          "action": {
            "op": "setCategories",
            "categories": []
          },
          "expect": {
            "emitted": [],
            "view": {
              "active": "",
              "empty": true
            }
          }
        }
      ]
    },
