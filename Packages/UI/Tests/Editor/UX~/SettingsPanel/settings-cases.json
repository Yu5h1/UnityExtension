          {
            "id": "appearance",
            "label": "外觀"
          },
          {
            "id": "animation",
            "label": "動畫"
          },
          {
            "id": "display",
            "label": "顯示"
          }
        ]
      },
      "steps": [
        {
          "action": {
            "op": "show"
          },
          "expect": {
