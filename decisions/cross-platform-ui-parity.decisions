      "id": "unpark",
      "version": 1,
      "question": "跨平台 UI 一致性目前「已排入、暫緩」，Unity 端要等具名產品需求才啟動。是否解除暫緩？",
      "context": "計畫〈啟動條件〉要求具名產品需求；Web 已交付 WEB-1 與 WEB-3 非物理 1.0.0，等待 Unity 驗收。",
      "source_ref": "Unity/UnityExtension/Documentation/跨平台UI一致性.md#啟動條件",
      "options": [
        {
          "id": "keep-parked",
          "label": "維持暫緩"
        },
        {
          "id": "unpark-unbound",
          "label": "解除暫緩，不綁產品"
        },
        {
          "id": "unpark-product",
          "label": "解除暫緩，綁定具名產品"
        }
      ],
      "allow_other": true,
      "status": "decided",
      "answer": {
        "kind": "option",
        "option_id": "unpark-unbound",
        "reason": "使用者 2026-10-06 於對話中決定；計畫與 handoff 尚未改寫",
        "confirmed_at": "2026-10-06T02:31:23+08:00"
      }
    },
